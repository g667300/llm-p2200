# cp .env.example .env and edit. .env is gitignored.

# Host port to publish.
LLAMA_PORT=8081

# Bind address. Default is loopback only. Use 0.0.0.0 or a specific IP to expose on the LAN (use a strong API key then).
LLAMA_BIND=127.0.0.1

# llama-server --api-key. Example: openssl rand -hex 24
LLAMA_CPP_API_KEY=CHANGE_ME
